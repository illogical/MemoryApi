# Add a new memory
POST http://localhost:3000/api/memories
Content-Type: application/json

{
  "Description": "My favorite southern chicken restaurant is Bojangles",
  "Content": "My favorite southern chicken restaurant is Bojangles because of the seasoned fries and their chicken breading.",
  "Category": "Preference",
  "Tags": ["Food", "Personal", "Favorite"]
}

###
# Add another new memory to test automatic tagging and categorization
POST http://localhost:3000/api/memories
Content-Type: application/json

{
  "Content": "I do not enjoy cooking because I find it time-consuming and not rewarding enough."
}

###
# Semantic search for the memory
POST http://localhost:3000/api/memories/search
Content-Type: application/json

{
  "query": "favorite restaurant with good chicken and fries",
  "limit": 3
}

###
# MCP-friendly semantic search and summary
# strategy options: 'linear' | 'cluster-category' | 'cluster-tag' | 'hybrid',
# format options: 'summary' | 'detailed' | 'both'
POST http://localhost:3000/api/memories/search-and-summarize
Content-Type: application/json

{
  "query": "favorite restaurant",
  "limit": 3,
  "scoreThreshold": 0.6,
  "strategy": "hybrid", 
  "format": "both"
}

###
POST http://localhost:3000/api/memories/search-and-summarize
Content-Type: application/json

{
  "query": "What conferences or events has the user attended?",
  "limit": 3,
  "scoreThreshold": 0.6,
  "strategy": "hybrid", 
  "format": "both"
}

###
# Get a memory by ID
# First create a memory above, copy the returned "id" and use it here
GET http://localhost:3000/api/memories/854efc86-4440-4f58-980f-37372d02ed4b
Accept: application/json

###
# Delete a memory by ID
DELETE http://localhost:3000/api/memories/{{memoryId}}
Content-Type: application/json

# Replace {{memoryId}} with the actual memory ID to delete


### More samples
###
# Semantic search for the memory if I add a memory that I do not enjoy cooking
POST http://localhost:3000/api/memories/search
Content-Type: application/json

{
  "query": "Do I like to cook?",
  "limit": 2
}

#####################################################################################################
###
# Review Queue API Tests
###
#####################################################################################################

# Add a memory to the review queue (should auto-generate metadata)
POST http://localhost:3000/api/review/queue
Content-Type: application/json

{
  "Content": "I prefer to work in the afternoon when it is quiet and I can focus."
}

###
# Get the review queue
GET http://localhost:3000/api/review/queue
Accept: application/json

###
# Update a memory in the review queue
# Replace {{queueId}} with an ID from the GET request above
PUT http://localhost:3000/api/review/queue/{{queueId}}
Content-Type: application/json

{
  "Category": "Preference",
  "Tags": ["Work", "Productivity", "Morning", "Focus"]
}

###
# Delete a memory from the review queue
# Replace {{queueId}} with an ID from the GET request above
DELETE http://localhost:3000/api/review/queue/{{queueId}}

###
# Get available categories
GET http://localhost:3000/api/review/categories
Accept: application/json

###
# Get available tags
GET http://localhost:3000/api/review/tags
Accept: application/json