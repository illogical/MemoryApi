{
  "name": "memory-api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn src/app/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "api": "npx tsx src/app/index.ts",
    "mcp": "npx tsx src/app/memoryMcpServer.ts",
    "hot": "nodemon --watch src --ext ts,js,json --exec npx tsx src/app/index.ts",
    "eval:tagging": "npx tsx src/scripts/evaluateTagging.ts --model=phi-4 --provider=lmstudio",
    "eval:category": "npx tsx src/scripts/evaluateCategorization.ts --model=phi-4 --provider=lmstudio",
    "eval:aggregation": "npx tsx src/scripts/evaluateSemanticQueries.ts --model=phi-4 --provider=lmstudio",
    "add-memory": "npx tsx src/scripts/addMemory.ts",
    "search-memories": "npx tsx src/scripts/searchMemories.ts",
    "init-sql": "npx tsx src/scripts/initDb.ts"
  },
  "dependencies": {
    "@lmstudio/sdk": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@qdrant/js-client-rest": "^1.15.1",
    "@types/express": "^5.0.5",
    "@types/sqlite3": "^3.1.11",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "neo4j-driver": "^6.0.1",
    "sqlite3": "^5.1.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
