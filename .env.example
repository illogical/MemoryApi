# MemoryAPI Environment Variables
# Copy this file to .env and fill in your values.
# All variables are optional — configService falls back to the defaults shown here.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── LLM / Inference ───────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_HOST=http://localhost:11434
LLM_MODEL=granite-3.3
EMBEDDING_MODEL=nomic-embed-text:v1.5

# ── Vector Store (Qdrant) ─────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Graph Store (Neo4j) ───────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── SQLite ────────────────────────────────────────────────────────────────────
SQLITE_DB_PATH=./data/memory.db

# ── Paths ─────────────────────────────────────────────────────────────────────
PROMPT_TEMPLATE_BASE_PATH=./src/prompts

# ── Integrations ──────────────────────────────────────────────────────────────
TODOIST_API_KEY=your_todoist_api_token_here

# ── Aggregation Pipeline Tuning ───────────────────────────────────────────────
# Max memories returned from combined vector + graph search before aggregation.
AGGREGATION_MAX_MEMORIES=25

# Clustering limits for cluster-category and cluster-tag strategies.
AGGREGATION_MAX_CLUSTERS=5
AGGREGATION_MAX_MEMORIES_PER_CLUSTER=8

# Minimum merged (vector+graph) score to include a result. Range: 0.0–1.0.
# Lower values improve recall for broad queries; higher values improve precision.
AGGREGATION_DEFAULT_SCORE_THRESHOLD=0.6

# Characters of memory content passed to the aggregation LLM per memory.
# Increase for longer memories; decrease to reduce prompt size.
AGGREGATION_CONTENT_MAX_CHARS=800

# Packed-memories character count that triggers the condensation pre-pass.
# If the serialized memory block exceeds this, a condensation LLM call runs first.
AGGREGATION_OVERFLOW_THRESHOLD_CHARS=15000

# Condensation batch size. 1 = single pre-pass over all memories.
# N > 1 = chunked summarization (N memories per batch, then meta-summarized).
AGGREGATION_CONDENSATION_BATCH_SIZE=1
