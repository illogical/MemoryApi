# MemoryAPI Environment Variables
# Copy this file to .env and fill in your values.
# All variables are optional — configService falls back to the defaults shown here.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── LLM / Inference ───────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_HOST=http://localhost:11434
LLM_MODEL=granite-3.3
# Optional per-ingestion-task overrides. Empty/unset values inherit LLM_MODEL.
LLM_MODEL_CLASSIFICATION=
LLM_MODEL_TAGGING=
LLM_MODEL_SUMMARY=
EMBEDDING_MODEL=nomic-embed-text:v1.5

# ── Memory Data Environment ───────────────────────────────────────────────────
# Selects which storage targets (SQLite, Qdrant, Neo4j) this instance uses.
#   production  = real remembered memories. Never used for tests or evals.
#   development = local/dev data. Seeded from seedMemories.json + sampleMemories.json.
#   test        = automated tests and prompt/model evals. Same seed files as dev.
MEMORY_DATA_ENV=development

# Safety guard. Must be explicitly true to allow writes/seeds to production.
# Reset/destructive scripts always refuse production regardless of this flag.
MEMORY_ALLOW_PRODUCTION_WRITES=false

# Optional metadata for test/eval runs. Only meaningful when MEMORY_DATA_ENV=test.
# MEMORY_TEST_RUN_TYPE can be: unit, integration, eval, manual
MEMORY_TEST_RUN_TYPE=manual
MEMORY_TEST_RUN_ID=

# ── Vector Store (Qdrant) ─────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# Qdrant collection for the selected environment.
#   production:  memoryapi_prod_memories
#   development: memoryapi_dev_memories (default)
#   test:        memoryapi_test_memories
QDRANT_COLLECTION_NAME=memoryapi_dev_memories

# ── Graph Store (Neo4j) ───────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Neo4j Community Edition supports only one database per server, so the default
# isolation strategy is one Neo4j instance per MemoryAPI environment.
# Use docker-compose.databases.yml (npm run databases:up) or equivalent separate containers.
NEO4J_ISOLATION_MODE=community-instances
NEO4J_PROD_URI=bolt://localhost:7687
NEO4J_DEV_URI=bolt://localhost:7688
NEO4J_TEST_URI=bolt://localhost:7689

# Resolved Neo4j target for the selected environment. In community-instances mode,
# configService derives NEO4J_URI from the *_URI values above and uses database
# "neo4j" in each separate instance.
NEO4J_URI=bolt://localhost:7688
NEO4J_DATABASE=neo4j

# Enterprise alternative: set NEO4J_ISOLATION_MODE=enterprise-databases and use
# one Neo4j Enterprise server. configService keeps NEO4J_URI and derives:
#   production:  memoryapi_prod
#   development: memoryapi_dev
#   test:        memoryapi_test

# ── SQLite ────────────────────────────────────────────────────────────────────
# SQLite path for the selected environment.
#   production:  ./data/prod/memory.db
#   development: ./data/dev/memory.db (default)
#   test:        ./data/test/memory.db
SQLITE_DB_PATH=./data/dev/memory.db

# ── Paths ─────────────────────────────────────────────────────────────────────
PROMPT_TEMPLATE_BASE_PATH=./src/prompts

# ── Integrations ──────────────────────────────────────────────────────────────
TODOIST_API_KEY=your_todoist_api_token_here

# ── Aggregation Pipeline Tuning ───────────────────────────────────────────────
# Max memories returned from combined vector + graph search before aggregation.
AGGREGATION_MAX_MEMORIES=25

# Clustering limits for cluster-category and cluster-tag strategies.
AGGREGATION_MAX_CLUSTERS=5
AGGREGATION_MAX_MEMORIES_PER_CLUSTER=8

# Minimum merged (vector+graph) score to include a result. Range: 0.0–1.0.
# Lower values improve recall for broad queries; higher values improve precision.
AGGREGATION_DEFAULT_SCORE_THRESHOLD=0.6

# Characters of memory content passed to the aggregation LLM per memory.
# Increase for longer memories; decrease to reduce prompt size.
AGGREGATION_CONTENT_MAX_CHARS=800

# Packed-memories character count that triggers the condensation pre-pass.
# If the serialized memory block exceeds this, a condensation LLM call runs first.
AGGREGATION_OVERFLOW_THRESHOLD_CHARS=15000

# Condensation batch size. 1 = single pre-pass over all memories.
# N > 1 = chunked summarization (N memories per batch, then meta-summarized).
AGGREGATION_CONDENSATION_BATCH_SIZE=1
